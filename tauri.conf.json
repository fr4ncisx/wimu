{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WIMU",
  "version": "0.5.2",
  "identifier": "dev.codexusagetray.desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WIMU",
        "width": 360,
        "height": 220,
        "minWidth": 320,
        "minHeight": 220,
        "maxHeight": 220,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/usage.ico"
    ]
  }
}
